{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "HubOpsWorkbench-2f91.json",
  "dataColors": ["#003865", "#C8742A", "#1C5E47", "#C8102E", "#64748B", "#8A6D14", "#2A9D8F", "#6B4C7A"],
  "good": "#1C5E47",
  "neutral": "#8A6D14",
  "bad": "#C8102E",
  "maximum": "#003865",
  "center": "#FFFFFF",
  "minimum": "#EAF1F5",
  "null": "#9CA3AF",
  "foreground": "#262626",
  "foregroundNeutralSecondary": "#605E5C",
  "foregroundNeutralTertiary": "#8A8886",
  "background": "#FFFFFF",
  "backgroundLight": "#F0F0F0",
  "backgroundNeutral": "#F3F2F1",
  "tableAccent": "#003865",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#262626" },
    "title": { "fontSize": 16, "fontFace": "Segoe UI Semibold", "color": "#003865" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#262626" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI, sans-serif", "color": "#262626" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#E0E0E0" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 8, "bottom": 8, "left": 8, "right": 8 }],
        "categoryAxis": [{ "gridlineStyle": "solid", "gridlineColor": { "solid": { "color": "#EDEDED" } } }],
        "valueAxis": [{ "gridlineStyle": "solid", "gridlineColor": { "solid": { "color": "#EDEDED" } } }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "autoSizeColumnWidth": true,
          "columnAdjustment": "growToFit",
          "backColor": { "solid": { "color": "#F3F2F1" } },
          "fontColor": { "solid": { "color": "#262626" } },
          "bold": true,
          "fontSize": 10
        }],
        "values": [{
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#FAFAFA" } },
          "fontColorPrimary": { "solid": { "color": "#262626" } },
          "fontColorSecondary": { "solid": { "color": "#262626" } },
          "fontSize": 10
        }],
        "total": [{
          "backColor": { "solid": { "color": "#EAF1F5" } },
          "fontColor": { "solid": { "color": "#262626" } },
          "bold": true
        }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{
          "autoSizeColumnWidth": true,
          "columnAdjustment": "growToFit",
          "backColor": { "solid": { "color": "#F3F2F1" } },
          "fontColor": { "solid": { "color": "#262626" } },
          "bold": true,
          "fontSize": 10
        }],
        "rowHeaders": [{
          "bold": true,
          "fontColor": { "solid": { "color": "#262626" } },
          "fontSize": 10
        }],
        "values": [{
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#FAFAFA" } },
          "fontColorPrimary": { "solid": { "color": "#262626" } },
          "fontColorSecondary": { "solid": { "color": "#262626" } },
          "fontSize": 10
        }],
        "total": [{
          "backColor": { "solid": { "color": "#EAF1F5" } },
          "fontColor": { "solid": { "color": "#262626" } },
          "bold": true
        }]
      }
    },
    "cardVisual": {
      "*": {
        "value": [{ "bold": true, "$id": "default" }],
        "label": [{ "show": true, "$id": "default" }],
        "cardCalloutArea": [{ "paddingUniform": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E0E0E0" } } }],
        "title": [{ "show": false }]
      }
    },
    "textbox": {
      "*": {
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }],
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "barChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "color": { "solid": { "color": "#262626" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true, "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } },
          "showAxisTitle": false, "innerPadding": 24, "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": false }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "color": { "solid": { "color": "#262626" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true, "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } },
          "showAxisTitle": false, "innerPadding": 24, "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#605E5C" } } }]
      }
    },
    "columnChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "color": { "solid": { "color": "#262626" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true, "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } },
          "showAxisTitle": false, "innerPadding": 24, "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": false }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 10, "color": { "solid": { "color": "#262626" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false, "showAxisTitle": false }],
        "categoryAxis": [{
          "show": true, "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } },
          "showAxisTitle": false, "innerPadding": 24, "gridlineShow": false
        }],
        "dataPoint": [{ "borderShow": false }],
        "legend": [{ "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#605E5C" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{
          "strokeWidth": 2.5, "lineChartType": "smooth", "interpolationSmooth": "monotoneX",
          "areaShow": true, "areaMatchStrokeColor": true
        }],
        "dataPoint": [{ "transparency": 85 }],
        "labels": [{ "show": false }],
        "categoryAxis": [{
          "show": true, "fontSize": 10, "labelColor": { "solid": { "color": "#605E5C" } },
          "showAxisTitle": false, "gridlineShow": false
        }],
        "valueAxis": [{
          "show": true, "fontSize": 9, "labelColor": { "solid": { "color": "#605E5C" } },
          "showAxisTitle": false, "gridlineStyle": "dotted", "gridlineColor": { "solid": { "color": "#E8E8E8" } }
        }],
        "legend": [{ "show": true, "position": "Top", "fontSize": 9, "labelColor": { "solid": { "color": "#605E5C" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{
          "fontFamily": "Segoe UI Semibold", "textSize": 10,
          "fontColor": { "solid": { "color": "#262626" } }, "outlineStyle": 0
        }],
        "items": [{
          "fontFamily": "Segoe UI, sans-serif", "textSize": 9,
          "fontColor": { "solid": { "color": "#262626" } }, "outlineStyle": 0, "padding": 2
        }],
        "date": [{
          "fontFamily": "Segoe UI, sans-serif", "textSize": 9,
          "fontColor": { "solid": { "color": "#262626" } }
        }]
      }
    }
  }
}
